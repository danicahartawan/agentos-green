{
  "domains": ["chrome", "libreoffice_calc", "os", "libreoffice_writer", "gimp"],
  "tasks": [
    {
      "id": "chrome_search_keyword",
      "domain": "chrome",
      "example_path": "examples/chrome/search_keyword.json",
      "fallback_check": "results page contains query string and results container",
      "expected": {"query": "OSWorld benchmark"}
    },
    {
      "id": "calc_edit_cell",
      "domain": "libreoffice_calc",
      "example_path": "examples/libreoffice_calc/edit_cell.json",
      "fallback_check": "cell B2 equals '42'",
      "expected": {"cell": "B2", "value": "42"}
    },
    {
      "id": "os_make_folder",
      "domain": "os",
      "example_path": "examples/os/make_folder.json",
      "fallback_check": "folder exists at ~/Desktop/demo_folder",
      "expected": {"path": "~/Desktop/demo_folder"}
    },
    {
      "id": "writer_bold_text",
      "domain": "libreoffice_writer",
      "example_path": "examples/libreoffice_writer/bold_text.json",
      "fallback_check": "document contains 'Hello' with bold style",
      "expected": {"text": "Hello"}
    },
    {
      "id": "gimp_export_png",
      "domain": "gimp",
      "example_path": "examples/gimp/export_png.json",
      "fallback_check": "file exported to ~/Pictures/out.png and is PNG",
      "expected": {"path": "~/Pictures/out.png", "format": "PNG"}
    }
  ]
}

